# Enter these in Coolify's Environment Variables interface, never in Git.
VISTA_IMAGE_TAG=staging-2026-09-11
VISTA_DEPLOYMENT_STAGE=staging
POS_FISCAL_SIMULATOR_ENABLED=true
POSTGRES_PASSWORD=
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
S3_SECRET_ACCESS_KEY=
BUSINESS_TIMEZONE=Europe/Sofia
TOTP_ISSUER=Vista Service Staging
CORS_ORIGINS=https://vista-ops.mydomain.com,https://vista-pos.mydomain.com,https://vista-recovery.mydomain.com
VITE_POS_APP_URL=https://vista-pos.mydomain.com
API_RATE_LIMIT_REDIS_PREFIX=vista:staging:rate-limit
# Optional Backup/DR SMS delivery. Keep disabled until credentials and recipient
# numbers are added as Coolify secrets/environment variables.
SMS_PROVIDER=disabled
BACKUP_ALERT_SMS_RECIPIENTS=
# Optional host-side root, already mounted read-only on the VPS. The API receives
# it read-only at /protected-sources; source records use relative paths beneath it.
BACKUP_FILE_SOURCE_HOST_PATH=/srv/vista/protected-sources
# Optional additional cloud buckets. Keep this JSON in Coolify secrets, not Git.
# Keys are protected-source codes; location in the source record must be bucket.
BACKUP_PRIMARY_OBJECT_STORAGE_SOURCE_CODE=VISTA-FILES-01
BACKUP_OBJECT_STORAGE_SOURCE_CONFIGS_JSON=
# Optional IMAP sources. Store this JSON in Coolify secrets, never in Git.
BACKUP_EMAIL_SOURCE_CONFIGS_JSON=
# Optional non-S3 cloud sources. WebDAV endpoint and read-only account go in
# Coolify secrets; never put credentials in source records or Git.
BACKUP_WEBDAV_SOURCE_CONFIGS_JSON=
# Keep disabled for staging until the separate storage target is configured.
# Production requires a distinct S3-compatible service, bucket and credentials.
BACKUP_REPLICA_REQUIRED=false
BACKUP_REPLICA_TARGET_CODE=independent-vault
BACKUP_REPLICA_S3_ENDPOINT=
BACKUP_REPLICA_S3_REGION=us-east-1
BACKUP_REPLICA_S3_BUCKET=
BACKUP_REPLICA_S3_ACCESS_KEY_ID=
BACKUP_REPLICA_S3_SECRET_ACCESS_KEY=
BACKUP_REPLICA_S3_FORCE_PATH_STYLE=false
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_API_BASE_URL=https://api.twilio.com
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
