# Merge into a protected copy of the site's environment; do not recreate it.
# Preserve the actual live database, MinIO root, session and TOTP secrets.
VISTA_IMAGE_TAG=
POSTGRES_PASSWORD=
S3_SECRET_ACCESS_KEY=
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
VISTA_DEPLOYMENT_STAGE=staging
ONPREM_CADDY_IMAGE=
# IPv4 address on the VPN or another approved private interface (not 0.0.0.0).
ONPREM_BIND_IP=
ONPREM_OPERATIONS_HOST=
ONPREM_POS_HOST=
ONPREM_RECOVERY_HOST=
# Site-private MinIO endpoint. If using a private CA, mount and trust it in the API.
ONPREM_S3_ENDPOINT=http://minio:9000
ONPREM_FILES_S3_ACCESS_KEY_ID=
ONPREM_FILES_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=vista-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_RESTORE_DATABASE_URL=
BACKUP_REPLICA_REQUIRED=false
BACKUP_REPLICA_S3_ENDPOINT=
BACKUP_REPLICA_S3_BUCKET=
BACKUP_REPLICA_S3_ACCESS_KEY_ID=
BACKUP_REPLICA_S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER=disabled
# See the environment reference for provider credentials and additional source settings.
