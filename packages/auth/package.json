{
  "name": "@vista/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser-session": {
      "types": "./dist/browser-session.d.ts",
      "import": "./dist/browser-session.js"
    }
