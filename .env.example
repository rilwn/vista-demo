# Development-only example values. Replace every change-me value outside local development.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_PREFIX=api/v1
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_PUBLIC_MAX=60
API_RATE_LIMIT_READ_MAX=240
API_RATE_LIMIT_WRITE_MAX=60
API_RATE_LIMIT_SENSITIVE_MAX=20
API_RATE_LIMIT_STORE=redis
API_RATE_LIMIT_REDIS_PREFIX=vista:rate-limit

MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# Set only to the exact number of trusted reverse-proxy hops in the deployment path.
API_TRUST_PROXY_HOPS=0
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_TTL_MS=60000
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
BUSINESS_TIMEZONE=Europe/Sofia
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Browser builds use the same-origin path by default. Override only for an approved deployment.
VITE_API_BASE_URL=/api/v1
DEPENDENCY_HEALTH_TIMEOUT_MS=2000
LOG_LEVEL=info
REQUEST_LOGGING_ENABLED=true

POSTGRES_DB=vista
POSTGRES_USER=vista
POSTGRES_PASSWORD=change-me-development-only
POSTGRES_PORT=55432
DATABASE_URL=postgresql://vista:change-me-development-only@localhost:55432/vista

REDIS_PORT=56379
REDIS_URL=redis://localhost:56379/0
IDEMPOTENCY_TTL_SECONDS=86400
JOB_QUEUE_NAME=platform
JOB_QUEUE_PREFIX=vista
JOB_DEFAULT_ATTEMPTS=5
JOB_BACKOFF_DELAY_MS=1000

# Daily at 01:15 in BUSINESS_TIMEZONE. Uses the BullMQ cron pattern format.
SALES_SUBSCRIPTION_INVOICE_CRON=0 15 1 * * *

# Daily at 01:25 in BUSINESS_TIMEZONE; detects unpaid review documents that have passed their due date.
FINANCE_PAYMENT_STATUS_CRON=0 25 1 * * *

# Creates one in-system reminder when a balance enters this upcoming-payment window.
FINANCE_PAYMENT_REMINDER_LEAD_DAYS=7
INTEGRATION_OUTBOX_BATCH_SIZE=100
INTEGRATION_OUTBOX_INTERVAL_MS=1000
INTEGRATION_OUTBOX_PROCESSING_TIMEOUT_MS=60000
NOTIFICATION_DISPATCH_INTERVAL_MS=5000
NOTIFICATION_PROCESSING_TIMEOUT_MS=300000

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=vista-development
S3_ACCESS_KEY_ID=vista-development
S3_SECRET_ACCESS_KEY=change-me-development-only
S3_FORCE_PATH_STYLE=true
FILE_ALLOWED_MEDIA_TYPES=application/pdf,image/jpeg,image/png,image/webp
FILE_UPLOAD_MAX_BYTES=10485760

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.invalid

# Secrets must be generated per environment and supplied by a secret manager.
SESSION_SECRET=change-me-at-least-32-characters-long
SESSION_TTL_SECONDS=28800
TOTP_ENCRYPTION_KEY=change-me-32-byte-base64-encoded-key
TOTP_ENROLLMENT_TTL_SECONDS=900
TOTP_ISSUER=Vista Service
TOTP_WINDOW_STEPS=1
ACCOUNT_RECOVERY_TTL_SECONDS=900

# Development candidates only. IAM-001 requires approved production values.
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true
PASSWORD_EXPIRY_DAYS=0
PASSWORD_HISTORY_COUNT=5

# Optional, local-only ERP/CRM demo fixtures. Keep disabled outside a private
# development database. Choose the password in the untracked .env file; never commit a shared development password.
DEV_FIXTURES_ENABLED=false
# DEV_FIXTURES_PASSWORD=

# One-time, controlled first-administrator provisioning. These are intentionally
# blank and are never used by normal startup. Set them only for the provisioning
# command, then remove INITIAL_ADMIN_PROVISIONING_ENABLED and the password.
# INITIAL_ADMIN_PROVISIONING_ENABLED=false
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_DISPLAY_NAME=
# INITIAL_ADMIN_EMPLOYEE_NUMBER=
# INITIAL_ADMIN_PASSWORD=

# Optional capabilities remain disabled until approved.
FEATURE_CUSTOMER_PORTAL=false
FEATURE_FIFO_COSTING=false
FEATURE_POS_KIOSK=false
FEATURE_POS_BACKUP_ROUTER=false
FEATURE_ELECTRONIC_SHELF_LABELS=false
FEATURE_ECOMMERCE_FISCALIZATION=false
FEATURE_BACKUP_EMERGENCY_ACCESS=false
