# Development-only example values. Replace every change-me value outside local development.
NODE_ENV=development
VISTA_DEPLOYMENT_STAGE=local
POS_FISCAL_SIMULATOR_ENABLED=false
FINANCE_OFFICIAL_NUMBER_BLOCK_SIZE=1000
API_HOST=0.0.0.0
API_PORT=3000
API_PREFIX=api/v1
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_PUBLIC_MAX=60
API_RATE_LIMIT_READ_MAX=240
API_RATE_LIMIT_WRITE_MAX=60
API_RATE_LIMIT_SENSITIVE_MAX=20
API_RATE_LIMIT_STORE=redis
API_RATE_LIMIT_REDIS_PREFIX=vista:rate-limit

MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# Set only to the exact number of trusted reverse-proxy hops in the deployment path.
API_TRUST_PROXY_HOPS=0
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_TTL_MS=60000
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
BUSINESS_TIMEZONE=Europe/Sofia
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Browser builds use the same-origin path by default. Override only for an approved deployment.
VITE_API_BASE_URL=/api/v1
# ERP/CRM link to the separate POS Reports page. Set the public POS origin in production.
VITE_POS_APP_URL=http://localhost:5174
DEPENDENCY_HEALTH_TIMEOUT_MS=2000
LOG_LEVEL=info
REQUEST_LOGGING_ENABLED=true

POSTGRES_DB=vista
POSTGRES_USER=vista
POSTGRES_PASSWORD=change-me-development-only
POSTGRES_PORT=55432
DATABASE_URL=postgresql://vista:change-me-development-only@localhost:55432/vista

REDIS_PORT=56379
REDIS_URL=redis://localhost:56379/0
IDEMPOTENCY_TTL_SECONDS=86400
JOB_QUEUE_NAME=platform
JOB_QUEUE_PREFIX=vista
JOB_DEFAULT_ATTEMPTS=5
JOB_BACKOFF_DELAY_MS=1000

# Daily at 01:15 in BUSINESS_TIMEZONE. Uses the BullMQ cron pattern format.
SALES_SUBSCRIPTION_INVOICE_CRON=0 15 1 * * *

# Daily at 01:25 in BUSINESS_TIMEZONE; detects unpaid review documents that have passed their due date.
FINANCE_PAYMENT_STATUS_CRON=0 25 1 * * *
CRM_SLA_EVALUATION_CRON=0 */5 * * * *

# Optional courier connections. Keep credentials blank until provider test access is available.
# Econt defaults to its demo endpoint. Set the production endpoint explicitly after sandbox tests.
LOGISTICS_ECONT_BASE_URL=https://demo.econt.com/ee/services
LOGISTICS_ECONT_USERNAME=
LOGISTICS_ECONT_PASSWORD=
LOGISTICS_ECONT_SENDER_NAME=
LOGISTICS_ECONT_SENDER_PHONE=
LOGISTICS_ECONT_SENDER_OFFICE_CODE=
# Speedy credentials and service ID are supplied by the carrier contract/account.
LOGISTICS_SPEEDY_BASE_URL=https://api.speedy.bg/v1
LOGISTICS_SPEEDY_USERNAME=
LOGISTICS_SPEEDY_PASSWORD=
LOGISTICS_SPEEDY_SERVICE_ID=

# Daily Service care checks in BUSINESS_TIMEZONE.
SERVICE_INSPECTION_REMINDER_CRON=0 35 1 * * *
SERVICE_PLAN_VISIT_HORIZON_DAYS=90
SERVICE_WARRANTY_REMINDER_CRON=0 40 1 * * *
SERVICE_WARRANTY_REMINDER_LEAD_DAYS=30
SERVICE_PLAN_VISIT_CRON=0 45 1 * * *

# Creates one in-system reminder when a balance enters this upcoming-payment window.
FINANCE_PAYMENT_REMINDER_LEAD_DAYS=7
INTEGRATION_OUTBOX_BATCH_SIZE=100
INTEGRATION_OUTBOX_INTERVAL_MS=1000
INTEGRATION_OUTBOX_PROCESSING_TIMEOUT_MS=60000
NOTIFICATION_DISPATCH_INTERVAL_MS=5000
NOTIFICATION_PROCESSING_TIMEOUT_MS=300000

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=vista-development
S3_ACCESS_KEY_ID=vista-development
S3_SECRET_ACCESS_KEY=change-me-development-only
S3_FORCE_PATH_STYLE=true
FILE_ALLOWED_MEDIA_TYPES=application/pdf,image/jpeg,image/png,image/webp
FILE_UPLOAD_MAX_BYTES=10485760

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.invalid
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional Backup/DR SMS alerts. Sending remains off unless a provider and
# recipient numbers are explicitly configured. Enter numbers in E.164 format.
SMS_PROVIDER=disabled
BACKUP_ALERT_SMS_RECIPIENTS=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_API_BASE_URL=https://api.twilio.com
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Secrets must be generated per environment and supplied by a secret manager.
SESSION_SECRET=change-me-at-least-32-characters-long
SESSION_TTL_SECONDS=28800
TOTP_ENCRYPTION_KEY=change-me-32-byte-base64-encoded-key
TOTP_ENROLLMENT_TTL_SECONDS=900
TOTP_ISSUER=Vista Service
TOTP_WINDOW_STEPS=1
ACCOUNT_RECOVERY_TTL_SECONDS=900

# Optional company-directory sign-in. Keep disabled until the Vista-owned
# provider is configured. External identities match existing employee emails;
# new Vista accounts are never created automatically.
DIRECTORY_AUTH_PROVIDER=disabled
# Emergency local-password access is limited to these employees, always requires
# a current authenticator code, and records the operator's reason in the audit log.
DIRECTORY_EMERGENCY_EMAILS=
# Exact directory group identifier -> existing Vista IAM role code(s). Example:
# {"CN=Finance,OU=Groups,DC=vista,DC=local":["finance"]}
DIRECTORY_GROUP_ROLE_MAPPINGS_JSON={}

# LDAP / Active Directory (service bind + user-password verification). Use
# LDAPS in production. AD/Entra deployments may instead use OIDC below.
DIRECTORY_LDAP_URL=
DIRECTORY_LDAP_BASE_DN=
DIRECTORY_LDAP_BIND_DN=
DIRECTORY_LDAP_BIND_PASSWORD=
DIRECTORY_LDAP_USER_FILTER=(&(objectClass=person)(mail={email}))
DIRECTORY_LDAP_EMAIL_ATTRIBUTE=mail
DIRECTORY_LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
DIRECTORY_LDAP_GROUP_ATTRIBUTE=memberOf

# OpenID Connect / Entra ID. Register the callback URL with the provider.
DIRECTORY_OIDC_ISSUER=
DIRECTORY_OIDC_CLIENT_ID=
DIRECTORY_OIDC_CLIENT_SECRET=
DIRECTORY_OIDC_CALLBACK_URL=
DIRECTORY_OIDC_EMAIL_CLAIM=email
DIRECTORY_OIDC_GROUPS_CLAIM=groups

# SAML 2.0. The generated Vista SP metadata endpoint is
# /api/v1/auth/directory/saml/metadata. Supply the IdP signing certificate.
DIRECTORY_SAML_ENTRY_POINT=
DIRECTORY_SAML_ISSUER=
DIRECTORY_SAML_CALLBACK_URL=
DIRECTORY_SAML_IDP_CERTIFICATE=
DIRECTORY_SAML_EMAIL_ATTRIBUTE=email
DIRECTORY_SAML_GROUPS_ATTRIBUTE=groups
# Only these front-end origins may receive the one-time sign-in ticket.
# {"operations":"https://vista-ops.example","pos":"https://vista-pos.example","recovery":"https://vista-recovery.example"}
DIRECTORY_LOGIN_RETURN_URLS_JSON={}

# Development candidates only. IAM-001 requires approved production values.
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SYMBOL=true
PASSWORD_EXPIRY_DAYS=0
PASSWORD_HISTORY_COUNT=5

# Optional, local-only ERP/CRM demo fixtures. Keep disabled outside a private
# development database. Choose the password in the untracked .env file; never commit a shared development password.
DEV_FIXTURES_ENABLED=false
# DEV_FIXTURES_PASSWORD=

# One-time, controlled first-administrator provisioning. These are intentionally
# blank and are never used by normal startup. Set them only for the provisioning
# command, then remove INITIAL_ADMIN_PROVISIONING_ENABLED and the password.
# INITIAL_ADMIN_PROVISIONING_ENABLED=false
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_DISPLAY_NAME=
# INITIAL_ADMIN_EMPLOYEE_NUMBER=
# INITIAL_ADMIN_PASSWORD=

# Optional capabilities remain disabled until approved.
FEATURE_CUSTOMER_PORTAL=false
FEATURE_FIFO_COSTING=false
FEATURE_POS_KIOSK=false
FEATURE_ELECTRONIC_SHELF_LABELS=false
FEATURE_ECOMMERCE_FISCALIZATION=false
FEATURE_BACKUP_EMERGENCY_ACCESS=false

# Backup files are stored separately from customer uploads and encrypted before upload.
# Generate a private 32-byte key (64 hex characters) and keep it in your secret manager.
BACKUP_S3_BUCKET=vista-backups
# Extra PostgreSQL sources are keyed by their protected-source code. Keep this
# JSON value in the deployment secret manager; never put production URLs here.
# The primary application database is mapped from DATABASE_URL by default.
BACKUP_PRIMARY_DATABASE_SOURCE_CODE=VISTA-DB-01
BACKUP_DATABASE_SOURCE_URLS_JSON=
# The Vista file bucket is the default source under VISTA-FILES-01. Additional
# read-only S3-compatible sources map a source code to a bucket and deployment
# secrets here; source records keep only the code and bucket name.
BACKUP_PRIMARY_OBJECT_STORAGE_SOURCE_CODE=VISTA-FILES-01
BACKUP_OBJECT_STORAGE_SOURCE_CONFIGS_JSON=
# Optional email sources use read-only IMAP credentials kept only in deployment
# secrets. Each entry includes host, port, TLS mode, username, password and mailbox list.
BACKUP_EMAIL_SOURCE_CONFIGS_JSON=
# Optional non-S3 cloud sources use read-only WebDAV credentials kept only in
# deployment secrets. Each entry includes endpoint, username and password.
BACKUP_WEBDAV_SOURCE_CONFIGS_JSON=
# Optional independent S3-compatible backup target. Use a different service,
# bucket, and credentials from primary storage. Production requires this target.
BACKUP_REPLICA_REQUIRED=false
BACKUP_REPLICA_TARGET_CODE=independent-vault
BACKUP_REPLICA_S3_ENDPOINT=
BACKUP_REPLICA_S3_REGION=us-east-1
BACKUP_REPLICA_S3_BUCKET=
BACKUP_REPLICA_S3_ACCESS_KEY_ID=
BACKUP_REPLICA_S3_SECRET_ACCESS_KEY=
BACKUP_REPLICA_S3_FORCE_PATH_STYLE=true
BACKUP_DISPATCH_CRON=0 * * * * *
# Optional read-only mounted root for approved file and shared-folder sources.
# Source locations are relative subfolders under this root; keep blank until mounted.
# BACKUP_FILE_SOURCE_ROOT=/protected-sources
# BACKUP_ENCRYPTION_KEY=
# Optional dedicated PostgreSQL restore target admin URL. Restore creates a new
# isolated database; it never overwrites DATABASE_URL. Leave blank to disable restore.
# BACKUP_RESTORE_DATABASE_URL=
