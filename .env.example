# Development-only example values. Replace every change-me value outside local development.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_PREFIX=api/v1
BUSINESS_TIMEZONE=Europe/Sofia
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
LOG_LEVEL=info

POSTGRES_DB=vista
POSTGRES_USER=vista
POSTGRES_PASSWORD=change-me-development-only
POSTGRES_PORT=55432
DATABASE_URL=postgresql://vista:change-me-development-only@localhost:55432/vista

REDIS_PORT=56379
REDIS_URL=redis://localhost:56379/0

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vista-development
S3_ACCESS_KEY_ID=vista-development
S3_SECRET_ACCESS_KEY=change-me-development-only
S3_FORCE_PATH_STYLE=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.invalid

# Secrets must be generated per environment and supplied by a secret manager.
SESSION_SECRET=change-me-at-least-32-characters-long
TOTP_ENCRYPTION_KEY=change-me-32-byte-base64-encoded-key

# Optional capabilities remain disabled until approved.
FEATURE_CUSTOMER_PORTAL=false
FEATURE_FIFO_COSTING=false
FEATURE_POS_KIOSK=false
FEATURE_POS_BACKUP_ROUTER=false
FEATURE_ELECTRONIC_SHELF_LABELS=false
FEATURE_ECOMMERCE_FISCALIZATION=false
FEATURE_BACKUP_EMERGENCY_ACCESS=false
